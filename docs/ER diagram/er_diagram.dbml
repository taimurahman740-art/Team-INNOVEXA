// INNOVEXA - Campus Maintenance System : ER diagram
// Paste this whole file into https://dbdiagram.io  (left panel) to draw the diagram.

Table departments {
  department_id int [pk, increment]
  name varchar(60) [not null, unique]
  description text
}

Table users {
  user_id int [pk, increment]
  name varchar(100) [not null]
  student_id varchar(20) [unique, note: 'NULL for staff and admin']
  email varchar(150) [not null, unique]
  role varchar(10) [not null, note: 'student | staff | admin']
  department_id int [note: 'staff only']
  password_hash varchar(255) [not null]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
}

Table buildings {
  building_id int [pk, increment]
  name varchar(100) [not null, unique]
}

Table locations {
  location_id int [pk, increment]
  building_id int [not null]
  floor smallint [not null]
  room varchar(20) [not null]

  indexes {
    (building_id, floor, room) [unique]
  }
}

Table reports {
  report_id int [pk, increment]
  user_id int [not null]
  location_id int [not null]
  description text [not null]
  image_url varchar(255)
  category varchar(40)
  status varchar(15) [not null, default: 'submitted']
  duplicate_of int [note: 'points to the original report']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table ai_analysis {
  analysis_id int [pk, increment]
  report_id int [not null, unique]
  category varchar(40)
  confidence numeric(5,2)
  hazard varchar(60)
  severity_score numeric(3,1)
  duplicate_score numeric(4,3)
  priority varchar(10) [note: 'low | medium | high | critical']
  priority_source varchar(10) [not null, default: 'rules', note: 'rules | ml']
  department_id int
  analyzed_at timestamp [not null, default: `now()`]
}

Table maintenance_tasks {
  task_id int [pk, increment]
  report_id int [not null, unique]
  department_id int [not null]
  staff_id int [note: 'NULL until accepted']
  priority varchar(10) [not null]
  status varchar(15) [not null, default: 'assigned']
  assigned_at timestamp [not null, default: `now()`]
  started_at timestamp
  completed_at timestamp
  response_due timestamp [note: 'escalation deadline']
}

Table escalations {
  escalation_id int [pk, increment]
  task_id int [not null]
  level smallint [not null, note: '1 = reminder, 2 = admin']
  reason text
  created_at timestamp [not null, default: `now()`]
}

Table status_history {
  history_id int [pk, increment]
  report_id int [not null]
  status varchar(15) [not null]
  changed_by int [note: 'NULL = system / AI']
  "timestamp" timestamp [not null, default: `now()`]
}

Table notifications {
  notification_id int [pk, increment]
  user_id int [not null]
  report_id int
  message text [not null]
  is_read boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
}

Table feedback {
  feedback_id int [pk, increment]
  report_id int [not null, unique]
  user_id int [not null]
  rating smallint [not null, note: '1 to 5']
  comment text
  created_at timestamp [not null, default: `now()`]
}

// ---------- Relationships ----------
Ref: users.department_id > departments.department_id
Ref: locations.building_id > buildings.building_id
Ref: reports.user_id > users.user_id
Ref: reports.location_id > locations.location_id
Ref: reports.duplicate_of > reports.report_id
Ref: ai_analysis.report_id - reports.report_id
Ref: ai_analysis.department_id > departments.department_id
Ref: maintenance_tasks.report_id - reports.report_id
Ref: maintenance_tasks.department_id > departments.department_id
Ref: maintenance_tasks.staff_id > users.user_id
Ref: escalations.task_id > maintenance_tasks.task_id
Ref: status_history.report_id > reports.report_id
Ref: status_history.changed_by > users.user_id
Ref: notifications.user_id > users.user_id
Ref: notifications.report_id > reports.report_id
Ref: feedback.report_id - reports.report_id
Ref: feedback.user_id > users.user_id
